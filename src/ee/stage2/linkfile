#
# Linkfile script for ee-ld
#
# Modified from the default $PS2SDK/ee/startup/linkfile: only the .text
# origin changed, from 0x00100000 (the standard base every normal PS2
# ELF loads at - including the resident dashboard that loads stage2 while
# still running) to 0x01000000. SifLoadElf() loads stage2 while the
# dashboard is still live in memory at 0x00100000; loading stage2 at the
# same address corrupts the running dashboard mid-load (confirmed via a
# TLB-miss/trap-exception crash during the M4 spike). 0x01000000 (16MB in)
# is comfortably clear of the dashboard's own footprint (currently under
# 1MB) while still well inside the 32MB EE RAM budget.
*/

ENTRY(__start);

PHDRS {
  text PT_LOAD;
}

SECTIONS {
	.text 0x01000000: {
		_ftext = . ;
		*(.text)
		*(.text.*)
		*(.gnu.linkonce.t*)
		KEEP(*(.init))
		KEEP(*(.fini))
		QUAD(0)
	} :text

	PROVIDE(_etext = .);
	PROVIDE(etext = .);

	/* Global/static constructors and deconstructors. This build never
	   links gcc's own crtbegin.o/crtend.o (-nostartfiles), so there's
	   no -1 start sentinel or 0 end terminator for crt0.c's own
	   __do_global_ctors-style walk to rely on - __CTOR_LIST__/
	   __CTOR_END__ give it real, safe bounds instead. */
	.ctors ALIGN(16): {
		PROVIDE(__CTOR_LIST__ = .);
		KEEP(*crtbegin*.o(.ctors))
		KEEP(*(EXCLUDE_FILE(*crtend*.o) .ctors))
		KEEP(*(SORT(.ctors.*)))
		KEEP(*(.ctors))
		PROVIDE(__CTOR_END__ = .);
	}
	.dtors ALIGN(16): {
		PROVIDE(__DTOR_LIST__ = .);
		KEEP(*crtbegin*.o(.dtors))
		KEEP(*(EXCLUDE_FILE(*crtend*.o) .dtors))
		KEEP(*(SORT(.dtors.*)))
		KEEP(*(.dtors))
		PROVIDE(__DTOR_END__ = .);
	}

	.reginfo : { *(.reginfo) }

	.data ALIGN(128): {
		_fdata = . ;
		*(.data)
		*(.data.*)
		*(.gnu.linkonce.d*)
		SORT(CONSTRUCTORS)
	}

	/* Static data.  */
	.rodata ALIGN(128): {
		*(.rodata)
		*(.rodata.*)
		*(.gnu.linkonce.r*)
	}

	.rdata ALIGN(128): { *(.rdata) }
	.gcc_except_table ALIGN(128): { *(.gcc_except_table) }

	_gp = ALIGN(128) + 0x7ff0;
	.lit4 ALIGN(128): { *(.lit4) }
	.lit8 ALIGN(128): { *(.lit8) }

	.sdata ALIGN(128): {
		*(.sdata)
		*(.sdata.*)
		*(.gnu.linkonce.s*)
	}

	_edata = .;
	PROVIDE(edata = .);

	/* Uninitialized data.  */
	.sbss ALIGN(128) : {
		_fbss = . ;
		*(.sbss)
		*(.sbss.*)
		*(.gnu.linkonce.sb*)
		*(.scommon)
	}

	.bss ALIGN(128) : {
		*(.bss)
		*(.bss.*)
		*(.gnu.linkonce.b*)
		*(COMMON)
	}
	_end_bss = .;

	_end = . ;
	PROVIDE(end = .);

	.spad 0x70000000: {
		*(.spad)
	}

	/* Symbols needed by crt0.s.  */
	PROVIDE(_heap_size = -1);
	PROVIDE(_stack = -1);
	PROVIDE(_stack_size = 128 * 1024);
}
